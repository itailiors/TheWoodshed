{
  "name": "reharm-lab",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n web,api -c blue,yellow \"npm run dev -w @reharm/web\" \"npm run dev -w @reharm/api\"",
    "dev:web": "npm run dev -w @reharm/web",
    "dev:api": "npm run dev -w @reharm/api",
    "test": "npm test --workspaces --if-present",
    "build": "npm run build -w @reharm/web",
    "build:demo": "npm run build:demo -w @reharm/web",
    "dev:demo": "concurrently -k -n web,api -c blue,yellow \"npm run dev:demo -w @reharm/web\" \"npm run dev:demo -w @reharm/api\"",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p e2e",
    "e2e": "npm run build:demo && playwright test",
    "e2e:nobuild": "playwright test"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "~1.65.1",
    "concurrently": "^10.0.7",
    "typescript": "^5.8.3"
  }
}
