# Copy to apps/api/.env and fill in. .env is git-ignored.

# Required: your Anthropic API key (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=

# Optional: model for /api/explain (default claude-opus-5-5)
# EXPLAIN_MODEL=claude-opus-5-5

# Optional: API port (default 8787; the Vite dev server proxies /api to it)
# PORT=8787
